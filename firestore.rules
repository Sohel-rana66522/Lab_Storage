rules_version = '2';

// Lab Ledger — Firestore Security Rules
//
// Two kinds of signed-in user:
//
//   STAFF   — real Firebase Auth accounts (email + password) created ahead of time for the
//             laboratory. They keep exactly the access they always had.
//
//   CLIENTS — visitors of the Client Portal. They sign in ANONYMOUSLY (no account, no
//             password). They may READ the catalogue (folders and chemicals, including the
//             live available quantity) and CREATE order requests. Nothing else:
//             no folder / chemical edits, no stock changes, no ledger access. They may READ
//             only the orders their own session placed (to see its status), and can never
//             edit or delete any order, their own included.
//
// ADMINS  — staff whose document users/{uid} has role == 'ADMIN'. Created by hand in the
//           Firebase console (nobody can write /users from the app). Only admins may approve
//           or reject client orders, and only an approval may generate order-linked ledger
//           entries.
//
// Stock is NEVER written directly by a client except through an atomic transaction that
// writes /chemicals/{id} and /transactions/{id} together — these rules require that pairing
// (TransactionRepository.record() for manual entries, OrderAdminRepository.approve() for
// orders).
//
// An order is only a REQUEST. Creating one never changes stock; approving it (admin only)
// atomically deducts stock, writes one ledger entry per item and marks the order Approved.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Anonymous (client portal) sessions are signed in but are never staff.
    function isStaff() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A staff account whose users/{uid} document says role == 'ADMIN'.
    // One document access only: a missing user document makes get() fail, which denies.
    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // ---------------------------------------------------------------------
    // users/{userId} — role records. Read-only from the app: roles are granted in the console.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isStaff() && request.auth.uid == userId;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // categories/{categoryId}  — folders
    // ---------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if signedIn();                       // staff + client portal
      allow create, update, delete: if isStaff();
    }

    // ---------------------------------------------------------------------
    // chemicals/{chemicalId} — chemical files
    // ---------------------------------------------------------------------
    match /chemicals/{chemicalId} {
      allow read: if signedIn();                       // staff + client portal

      // Creation may include an opening-balance stock figure, but it must
      // never be negative.
      allow create: if isStaff() && request.resource.data.currentStock >= 0;

      // Metadata-only edit: currentStock, lastTransactionId, lastEntryAt and
      // lastEntryDelta must be untouched. Stock changes are only allowed via
      // the paired transaction write below (matched by lastTransactionId
      // pointing at a transaction this same request creates).
      allow update: if isStaff() && (
        (
          request.resource.data.currentStock == resource.data.currentStock &&
          request.resource.data.lastTransactionId == resource.data.lastTransactionId
        ) ||
        (
          request.resource.data.currentStock >= 0 &&
          getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.lastTransactionId)).data.chemicalId == chemicalId
        )
      );

      // A chemical file is never deleted from the client; it holds audit history.
      allow delete: if false;
    }

    function validOrderIssue(transactionId) {
      let d = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(d.orderId);
      return isAdmin()
        && d.orderId is string
        && d.type == 'OUT'
        && transactionId.matches(d.orderId + '-[0-9]+')
        && get(orderPath).data.status == 'Pending'
        && getAfter(orderPath).data.status == 'Approved'
        && getAfter(orderPath).data.approvedBy == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // transactions/{transactionId} — the immutable ledger (staff only)
    // It records student names and IDs, so the client portal cannot read it.
    // ---------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow read: if isStaff();

      // Must be attributed to the actor making the request, and must
      // reference a chemical that actually exists.
      //
      // An entry that carries an orderId is a stock issue generated by an order approval. It
      // is only accepted from an admin, as a usage (OUT) entry with the id `<orderId>-<n>`,
      // in the SAME request that moves that order from Pending to Approved. Together with
      // "ledger entries can never be updated" this makes a second deduction for the same
      // order impossible.
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == transactionId
        && existsAfter(/databases/$(database)/documents/chemicals/$(request.resource.data.chemicalId))
        && (request.resource.data.get('orderId', null) == null || validOrderIssue(transactionId));

      // Immutable audit trail: no client-side edits or deletes, ever.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // orders/{orderId} — chemical requests from the client portal
    // ---------------------------------------------------------------------
    // Free text must contain at least one non-space character and stay under [max] chars.
    function nonBlank(value, max) {
      return value is string && value.size() <= max && value.matches('.*\\S.*');
    }

    function validNewOrder(orderId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'clientName', 'clientId', 'supervisorName', 'items',
                               'itemCount', 'status', 'clientUid', 'createdAt'])
        && d.keys().hasAll(['id', 'clientName', 'clientId', 'supervisorName', 'items',
                            'itemCount', 'status', 'clientUid', 'createdAt'])
        && orderId.matches('LAB-[A-HJ-NP-Z2-9]{8}')    // same alphabet OrderRepository.newOrderId uses
        && d.id == orderId
        && d.clientUid == request.auth.uid              // the order belongs to the session that sent it
        && d.status == 'Pending'                        // a client can only ever ask, never self-approve
        && d.createdAt == request.time                  // server clock, not the client's
        && nonBlank(d.clientName, 120)
        && nonBlank(d.clientId, 60)
        && nonBlank(d.supervisorName, 120)
        && d.items is list
        && d.items.size() >= 1
        && d.items.size() <= 7
        && d.itemCount is int
        && d.itemCount == d.items.size();
    }

    // Pending -> Approved, by an admin, in the same request that creates the order's ledger
    // entries. Rules cannot loop, so the first and last entry (ids <orderId>-1 and
    // <orderId>-<itemCount>) are checked; transactionIds must list exactly itemCount ids.
    //
    // Firestore allows at most 20 document-access calls per transaction commit. An approval
    // needs about 2 per item (the chemical and its ledger entry) plus 3 fixed (the admin's
    // user document and the order before/after), so an order is limited to 7 items
    // (OrderRepository.maxItems / OrderAdminRepository.maxItemsPerApproval — keep in step).
    function validApproval(orderId) {
      let d = request.resource.data;
      return d.status == 'Approved'
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedAt', 'approvedBy', 'approvedByName',
                       'transactionIds', 'updatedAt'])
        && d.approvedBy == request.auth.uid             // never trust a client-supplied admin
        && d.approvedAt == request.time
        && d.transactionIds is list
        && d.transactionIds.size() == resource.data.itemCount
        && getAfter(/databases/$(database)/documents/transactions/$(orderId + '-1')).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/transactions/$(orderId + '-' + string(resource.data.itemCount))).data.orderId == orderId;
    }

    // Pending -> Rejected, by an admin. Stock and the ledger are not touched.
    function validRejection() {
      let d = request.resource.data;
      return d.status == 'Rejected'
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'rejectedAt', 'rejectedBy', 'rejectedByName',
                       'rejectionReason', 'updatedAt'])
        && d.rejectedBy == request.auth.uid
        && d.rejectedAt == request.time
        && (!('rejectionReason' in d)
            || (d.rejectionReason is string && d.rejectionReason.size() <= 500));
    }

    match /orders/{orderId} {
      // The only write a client can make anywhere in the database. Create-only: an existing
      // order can never be overwritten, so one client cannot alter another's request.
      allow create: if signedIn() && validNewOrder(orderId);

      // Staff read every order. A client portal session reads ONLY the orders it placed
      // (matched by the anonymous uid stored on the order), never anyone else's.
      allow read: if isStaff()
        || (signedIn() && resource.data.clientUid == request.auth.uid);

      // Only an admin, only from Pending, and only to Approved/Rejected with the matching
      // metadata. Approved and Rejected are final: nothing can edit them afterwards, and
      // the client's original request (name, ID, supervisor, items) never changes.
      allow update: if isAdmin()
        && resource.data.status == 'Pending'
        && (validApproval(orderId) || validRejection());

      allow delete: if false;
    }
  }
}
