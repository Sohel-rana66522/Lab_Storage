rules_version = '2';

// Lab Ledger — Firestore Security Rules
//
// Simple model: any signed-in Firebase Auth user has full access. There is
// no separate profile document and no roles — Firebase Auth is the only
// source of truth for "is this person allowed in".
//
// Stock is NEVER written directly by a client except through the atomic
// transaction in TransactionRepository.record(), which writes
// /chemicals/{id} and /transactions/{id} together — these rules require
// that pairing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------------------------------------------------------------------
    // categories/{categoryId}  — folders
    // ---------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // ---------------------------------------------------------------------
    // chemicals/{chemicalId} — chemical files
    // ---------------------------------------------------------------------
    match /chemicals/{chemicalId} {
      allow read: if signedIn();

      // Creation may include an opening-balance stock figure, but it must
      // never be negative.
      allow create: if signedIn() && request.resource.data.currentStock >= 0;

      // Metadata-only edit: currentStock, lastTransactionId, lastEntryAt and
      // lastEntryDelta must be untouched. Stock changes are only allowed via
      // the paired transaction write below (matched by lastTransactionId
      // pointing at a transaction this same request creates).
      allow update: if signedIn() && (
        (
          request.resource.data.currentStock == resource.data.currentStock &&
          request.resource.data.lastTransactionId == resource.data.lastTransactionId
        ) ||
        (
          request.resource.data.currentStock >= 0 &&
          existsAfter(/databases/$(database)/documents/transactions/$(request.resource.data.lastTransactionId)) &&
          get(/databases/$(database)/documents/transactions/$(request.resource.data.lastTransactionId)).data.chemicalId == chemicalId
        )
      );

      // A chemical file is never deleted from the client; it holds audit history.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // transactions/{transactionId} — the immutable ledger
    // ---------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow read: if signedIn();

      // Must be attributed to the actor making the request, and must
      // reference a chemical that actually exists.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == transactionId
        && existsAfter(/databases/$(database)/documents/chemicals/$(request.resource.data.chemicalId));

      // Immutable audit trail: no client-side edits or deletes, ever.
      allow update, delete: if false;
    }
  }
}
